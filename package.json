{
  "name": "puls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "seed:generate": "node --experimental-strip-types scripts/generate-seed.mjs",
    "check": "npm run lint && npm run build && npm test",
    "design-system:local": "node scripts/design-system.mjs local",
    "design-system:registry": "node scripts/design-system.mjs registry",
    "update:design-system": "node scripts/design-system.mjs update",
    "sync:guidance": "ds-guidance init --mode package --brand hufvudstaden --target ."
  },
  "dependencies": {
    "@hufvudstaden/design-system": "file:vendor/hufvudstaden-design-system-0.17.1-76b5e3d439cd.tgz",
    "@supabase/supabase-js": "^2.0.0",
    "date-fns": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0"
  }
}
